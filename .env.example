DB_HOST=db
DB_PORT=3306
DB_NAME=cacao_monitoring
DB_USER=root
DB_PASSWORD=root
PORT=3000
JWT_SECRET=change_this_secret

# Notes:
# - When running with docker-compose, set DB_HOST=db
# - Do NOT commit your real .env to source control
# Variables de entorno para Tesis Angie Backend

# Puerto del servidor
PORT=3000

# URL de la base de datos MongoDB
MONGODB_URI=mongodb://localhost:27017/tesis_angie

# Clave secreta para JWT (cambiar en producción)
JWT_SECRET=tu_clave_secreta_muy_segura_aqui_2024

# Configuración de base de datos alternativa
# Para MongoDB Atlas (si decides usar la nube):
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/tesis_angie

# Configuración de desarrollo
NODE_ENV=development

# Configuración de CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Límites de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100