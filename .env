# Variables de entorno para Tesis Angie Backend

# Puerto del servidor
PORT=3000

# Configuración de base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cacao_monitoring
DB_USER=root
DB_PASSWORD=samus2016

# Configuración SSL de MySQL (opcional)
DB_SSL=false

# Configuración de pool de conexiones
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Timezone de la base de datos
DB_TIMEZONE=-05:00

# Clave secreta para JWT (cambiar en producción)
JWT_SECRET=tu_clave_secreta_muy_segura_aqui_2024

# Tiempo de expiración de tokens
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Configuración de desarrollo
NODE_ENV=development

# URL del frontend para CORS
FRONTEND_URL=http://localhost:5173

# Configuración de CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Límites de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuración de email (para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cacaomonitoring.com

# Configuración de archivos
MAX_FILE_SIZE=10mb
UPLOAD_PATH=uploads/

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Configuración de seguridad
BCRYPT_ROUNDS=12
SESSION_SECRET=tu_session_secret_aqui

# URLs de servicios externos
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Configuración de alertas
ALERT_EMAIL_ENABLED=true
ALERT_SMS_ENABLED=false

# Configuración de backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION=30d