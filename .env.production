# CONFIGURACIÓN DE PRODUCCIÓN PARA DOKPLOY
# ⚠️ IMPORTANTE: Configura estas variables en Dokploy

# Base de datos MySQL
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=cacao_monitoring
DB_USER=root
DB_PASSWORD=samus2016

# Puerto del servidor
PORT=3000

# Entorno
NODE_ENV=production

# URL base del API
BASE_URL=https://api.jorgelp.cloud

# JWT Secret (¡CAMBIAR POR UNO SEGURO!)
JWT_SECRET=TU_JWT_SECRET_SUPER_SEGURO_PARA_PRODUCCION_2024

# Configuración de pool de conexiones
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Timezone
DB_TIMEZONE=-05:00

# CORS (URLs permitidas - tu dominio)
CORS_ORIGIN=https://jorgelp.cloud,https://www.jorgelp.cloud,https://api.jorgelp.cloud,http://localhost:3000,http://localhost:3001

# Rate limiting (producción)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SSL de base de datos (si es necesario)
DB_SSL=false
